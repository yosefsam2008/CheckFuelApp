{
  "expo": {
    "name": "CheckFuel",
    "slug": "checkfuel",
    "version": "1.5.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "checkfuel",
    "userInterfaceStyle": "light",
    "description": "מחשבון דלק וחלוקת עלות הנסיעה בין נוסעים",
    "assetBundlePatterns": [
      "**/*"
    ],
    "locales": {
      "he": "./locales/he.json"
    },
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.checkfuel.app",
      "requireFullScreen": true,
      "buildNumber": "2.5.1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "he",
        "CFBundleLocalizations": [
          "he"
        ],
        "LSApplicationQueriesSchemes": [
          "waze",
          "comgooglemaps"
        ]
      }
    },
    "android": {
      "package": "com.checkfuel.app",
      "versionCode": 19,
      "permissions": [
        "INTERNET"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/images/adaptive-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-web-browser",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CheckFuel משתמשת במיקום שלך כדי לחשב את מרחק הנסיעה ליעד."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6526080198496101~4862609395",
          "iosAppId": "ca-app-pub-6526080198496101~2229629977",
          "delayAppMeasurementInit": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "8a6e291b-1c4a-4993-a5eb-556b3f09ab0a"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8a6e291b-1c4a-4993-a5eb-556b3f09ab0a"
    }
  }
}